<section class="hero">
  <h1>Welcome to Recipe Website</h1>
  <p>Discover and share delicious recipes from around the world.</p>

  <form class="search-form search-form-lg search-form-hero" action="/search" method="GET" role="search">
    <input
      type="search"
      name="q"
      placeholder="Search recipes by name or ingredient&hellip;"
      aria-label="Search recipes"
      maxlength="100"
    >
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <div class="hero-actions">
    <a href="/browse" class="btn btn-outline btn-lg">Browse All Recipes</a>
    <% if (!user) { %>
      <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
    <% } else { %>
      <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
    <% } %>
  </div>
</section>

<section class="features">
  <h2>Why Choose Us?</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>Easy to Use</h3>
      <p>Simple and intuitive interface for managing your recipes.</p>
    </div>
    <div class="feature-card">
      <h3>Secure</h3>
      <p>Your data is protected with industry-standard encryption.</p>
    </div>
    <div class="feature-card">
      <h3>Share & Discover</h3>
      <p>Connect with other food lovers and discover new recipes.</p>
    </div>
  </div>
</section>

<section class="auth-page">
  <div class="auth-card">
    <% if (state === "form") { %>
      <h1>Set a new password</h1>
      <p>Choose a new password for your account.</p>

      <form action="/auth/reset-password" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="password">New password</label>
          <input type="password" id="password" name="password" required minlength="8" placeholder="At least 8 characters">
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm new password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Type it again">
        </div>

        <button type="submit" class="btn btn-primary btn-block">Update Password</button>
      </form>
    <% } else if (state === "error") { %>
      <h1>This reset link is invalid or has expired</h1>
      <p><%= message %></p>

      <a href="/auth/forgot-password" class="btn btn-primary btn-block">Request a new reset email</a>

      <p class="auth-footer">
        <a href="/auth/login">Back to Sign In</a>
      </p>
    <% } else { %>
      <!-- "checking" state: public/js/auth-recovery.js looks for this
           element to tell whether it's on this page with no fragment and
           no query params -- if so, and JS ran, it forwards to the error
           state below (see auth-recovery.js). Real users never stay on
           this screen for more than a moment. -->
      <div id="auth-recovery-checking">
        <h1>Verifying your reset link&hellip;</h1>
        <p>Hang tight, this only takes a moment.</p>
      </div>

      <noscript>
        <h1>This reset link is invalid or has expired</h1>
        <p><%= message %></p>

        <a href="/auth/forgot-password" class="btn btn-primary btn-block">Request a new reset email</a>

        <p class="auth-footer">
          <a href="/auth/login">Back to Sign In</a>
        </p>
      </noscript>
    <% } %>
  </div>
</section>

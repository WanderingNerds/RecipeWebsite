<section class="auth-page">
  <div class="auth-card">
    <h1>Confirm your email</h1>
    <p>Enter your email to receive a new confirmation link.</p>

    <form action="/auth/resend-confirmation" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" value="<%= email %>">
      </div>

      <button type="submit" class="btn btn-primary btn-block">Send confirmation email</button>
    </form>

    <p class="auth-footer">
      Already confirmed? <a href="/auth/login">Sign in</a>
    </p>
  </div>
</section>

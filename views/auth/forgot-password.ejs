<section class="auth-page">
  <div class="auth-card">
    <h1>Reset your account access</h1>
    <p>Enter your email and choose the recovery action you need.</p>

    <form action="/auth/forgot-password" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" value="<%= email %>">
      </div>

      <button type="submit" formaction="/auth/forgot-password" class="btn btn-primary btn-block">Send Password Reset Email</button>
      <button type="submit" formaction="/auth/resend-confirmation" class="btn btn-secondary btn-block">Resend Confirmation Email</button>
    </form>

    <p class="auth-footer">
      <a href="/auth/login">Back to Sign In</a>
    </p>
  </div>
</section>

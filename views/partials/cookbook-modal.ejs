<!-- Add to Cookbook Modal (REW-86) -->
<!-- Static modal markup included once in the layout (gated on `user`),
     wired up by public/js/cookbooks.js -- structurally modeled on
     views/partials/meal-plan-modal.ejs (same inline-style convention; this
     repo has no first-class `.modal` CSS class yet). -->
<div id="cookbookModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 1000; align-items: center; justify-content: center;">
  <div class="modal-content" style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15); max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h3 style="margin: 0;">Add to Cookbook</h3>
      <button type="button" id="closeCookbookModal" aria-label="Close" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>

    <p id="cookbookModalStatus" style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;"></p>

    <div id="cookbookModalList" style="margin-bottom: 1rem;"></div>

    <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
      <button type="button" id="cookbookModalNewToggle" class="btn btn-outline" style="width: 100%; margin-bottom: 0.75rem;">+ New cookbook</button>

      <form id="cookbookModalNewForm" style="display: none;">
        <div class="form-group">
          <label for="cookbookModalTitle">Title <span style="color: var(--error-color);">*</span></label>
          <input type="text" id="cookbookModalTitle" name="title" placeholder="e.g. Weeknight Dinners" required maxlength="200">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Create &amp; Add Recipe</button>
      </form>
    </div>

  </div>
</div>

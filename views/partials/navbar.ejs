<nav class="navbar">
  <div class="container navbar-container">
    <div class="navbar-header">
      <a href="/" class="navbar-brand">
        <img src="/images/logo-mark.svg" alt="Potluck logo" class="navbar-brand-mark" width="28" height="28">
        Potluck
      </a>

      <button
        type="button"
        class="navbar-toggle"
        id="navbar-toggle"
        aria-controls="navbar-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="navbar-toggle-bar"></span>
        <span class="navbar-toggle-bar"></span>
        <span class="navbar-toggle-bar"></span>
      </button>
    </div>

    <form class="search-form search-form-nav" action="/search" method="GET" role="search">
      <input
        type="search"
        name="q"
        value="<%= typeof query !== 'undefined' ? query : '' %>"
        placeholder="Search recipes&hellip;"
        aria-label="Search recipes"
        maxlength="100"
      >
      <button type="submit" class="btn btn-primary" aria-label="Search">Search</button>
    </form>

    <div class="navbar-menu" id="navbar-menu" aria-hidden="true">
      <ul class="navbar-nav">
        <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/browse" class="<%= currentPath.startsWith('/browse') ? 'active' : '' %>">Browse</a></li>

        <% if (user) { %>
          <li><a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a></li>
          <li><a href="/recipes" class="<%= currentPath === '/recipes' || (currentPath.startsWith('/recipes/') && currentPath !== '/recipes/liked') ? 'active' : '' %>">My Recipes</a></li>
          <li><a href="/recipes/liked" class="<%= currentPath === '/recipes/liked' ? 'active' : '' %>">Liked</a></li>
          <li><a href="/cookbooks" class="<%= currentPath === '/cookbooks' || currentPath.startsWith('/cookbooks/') ? 'active' : '' %>">Cookbooks</a></li>
          <li><a href="/meal-plans" class="<%= currentPath === '/meal-plans' || currentPath.startsWith('/meal-plans/') ? 'active' : '' %>">Meal Plans</a></li>
          <li class="navbar-user">
            <span>Hello, <%= user.user_metadata?.name || user.email %></span>
            <a href="/auth/logout" class="btn btn-outline-light">Logout</a>
          </li>
        <% } else { %>
          <li><a href="/auth/login" class="<%= currentPath === '/auth/login' ? 'active' : '' %>">Login</a></li>
          <li><a href="/auth/register" class="btn btn-primary">Sign Up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

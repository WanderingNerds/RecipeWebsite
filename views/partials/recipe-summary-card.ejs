<%#
  Shared recipe summary card.

  REW-59 built the Browse card, REW-86 added the My Recipes owner card,
  REW-87 added My Favorites, REW-88 added Cookbook and REW-89 adds Meal Plan.
  The five are described by one `surface` local:

    'browse'     - public, non-actionable, read-only status pill
    'my-recipes' - uniformly owned by the viewer
    'favorites'  - MIXED ownership: mostly other people's published recipes,
                   sometimes the viewer's own
    'cookbook'   - the recipes inside one cookbook. Owner-only today, MIXED
                   once REW-100 lands. Carries the page-specific Remove
                   action and is the one surface with no `+ Cookbook`.
    'meal-plan'  - the recipes inside one meal plan. GENUINELY MIXED today:
                   the RLS INSERT policy on meal_plan_recipes (migration 012)
                   admits your own recipes OR anyone's published recipe.
                   Carries the page-specific Remove action and is the one
                   surface with no `+ Meal Plan`.

  `isPublic` used to encode "public surface" and "owner surface" as a single
  axis, which favorites breaks. Ownership is therefore decided per card via
  `isOwner` below. `surface` is optional and falls back to the old boolean so
  existing callers (browse.ejs, index.ejs) keep working untouched -- EJS
  throws on undefined locals, so every optional local is read through
  `typeof` exactly the way `selectedCategory` already is.

  SECURITY: `isOwner` is presentational only. It decides whether Edit/Delete
  are DRAWN; the real protection is the ownership filter + RLS on
  /recipes/:id/edit, /:id/update and /:id/delete. `recipe.user_id` is read
  here to compute the flag and must never be rendered into the markup.
%><%
  const viewer = typeof user !== 'undefined' ? user : null;
  const cardSurface = typeof surface !== 'undefined' && surface
    ? surface
    : ((typeof isPublic !== 'undefined' && isPublic) ? 'browse' : 'my-recipes');

  const isBrowse = cardSurface === 'browse';
  const isMyRecipes = cardSurface === 'my-recipes';
  const isFavorites = cardSurface === 'favorites';
  const isCookbook = cardSurface === 'cookbook';
  const isMealPlan = cardSurface === 'meal-plan';

  // REW-88: the cookbook Remove form needs the id of the cookbook being
  // viewed. Optional and read through `typeof` like `surface` above, under a
  // distinct name so the const cannot shadow the local it reads. A caller
  // that forgets to pass it gets no Remove button rather than a broken URL.
  const cardCookbookId = typeof cookbookId !== 'undefined' && cookbookId ? cookbookId : null;

  // REW-89: the same contract for the meal plan Remove form. A caller that
  // forgets it gets no Remove button rather than a form posting to
  // /meal-plans//recipes/...
  const cardMealPlanId = typeof mealPlanId !== 'undefined' && mealPlanId ? mealPlanId : null;

  // Guarded on both sides: a recipe with no user_id (sparse fixture, or a
  // surface that simply does not fetch the column) is treated as NOT owned.
  const isOwner = Boolean(viewer && viewer.id && recipe.user_id && viewer.id === recipe.user_id);

  // Browse is the only anonymous-safe surface, so it is the only one that
  // links to the public read-only view. /recipes/:id serves own-or-published
  // and computes its own isOwner, so favorites can link there safely.
  const recipeHref = isBrowse ? `/r/${recipe.id}` : `/recipes/${recipe.id}`;

  // Per-surface controls, named once so the markup below stays readable.
  // The Private/Public toggle stays exclusive to the my-recipes branch below,
  // and + Cookbook / Share / the favorite heart stay off browse.
  //
  // REW-88: the heart and the status pill used to be one either/or decision.
  // Cookbook needs BOTH -- a cookbook can hold the owner's Private recipes,
  // and REW-19 sharing hides those from the shared /c/:id view, so the pill
  // is the only place the owner is told that. They are therefore two
  // independent flags rendering into the same header row.
  //
  // REW-89 extends the pill to meal plans on exactly the same reasoning:
  // REW-69 sharing hides Private recipes from the shared /m/:id view, so the
  // pill is how the owner learns a Private recipe will not appear to the
  // people they share the plan with. Owner-gated on both surfaces -- a viewer
  // is never shown a status claim about somebody else's recipe.
  const showFavoriteHeart = !isBrowse;
  const showStatusPill = isBrowse || (isCookbook && isOwner) || (isMealPlan && isOwner);
  const showOwnerControls = isOwner && !isBrowse; // Edit + Delete
  // A cookbook recipe is already in a cookbook, so `+ Cookbook` is suppressed
  // there. Display rule only: POST /api/cookbooks/:id/recipes/:recipeId keeps
  // its auth, rate limiter and UUID guards whether or not a button is drawn.
  const showCookbookAdd = !isBrowse && !isCookbook;
  // REW-89, the exact analogue: a meal plan recipe is already in a meal plan,
  // so `+ Meal Plan` is suppressed there. Display rule only -- POST
  // /api/meal-plans/:id/recipes/:recipeId keeps requireApiAuth,
  // mealPlanApiLimiter and its UUID guards whether or not a button is drawn.
  const showMealPlanAdd = !isMealPlan;
  const chipsAreLinks = isMyRecipes;              // /recipes?category= filters YOUR recipes
  const showAdaptedFrom = !isBrowse;
%>
        <div class="feature-card recipe-summary-card" style="position: relative; display: flex; flex-direction: column;">
          <!-- Recipe thumbnail -->
          <% if (recipe.thumbnail_url) { %>
            <a href="<%= recipeHref %>" style="display: block; margin-bottom: 1rem;">
              <div class="photo-placeholder" style="width: 100%; height: 200px; border-radius: var(--radius); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <img src="<%= recipe.thumbnail_url %>" alt="<%= recipe.title %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            </a>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem; gap: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="<%= recipeHref %>" style="color: inherit; text-decoration: none;">
                <%= recipe.title %>
              </a>
            </h3>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <% if (showFavoriteHeart) { %>
              <% if (recipe.status === 'published') { %>
                <button class="like-btn" data-recipe-id="<%= recipe.id %>" data-liked="<%= recipe.isLiked %>" aria-label="<%= recipe.isLiked ? 'Remove from favorites' : 'Favorite this recipe' %>">
                  <span class="like-btn-icon">&#9829;</span>
                </button>
              <% } else { %>
                <button class="like-btn" disabled aria-label="Make this recipe Public to add it to favorites" title="Make this recipe Public to add it to favorites">
                  <span class="like-btn-icon">&#9829;</span>
                </button>
              <% } %>
              <% } %><% if (showStatusPill) { %>
              <%#
                Browse keeps the read-only status pill. The owner surface
                below replaces it with the labelled Private/Public control
                (REW-86), so the state is never shown twice on one card.
                Favorites shows neither: every recipe reachable from that
                page is published, so a "Public" pill on every card is noise.
                Cookbook (REW-88) shows it to the OWNER only: it is how the
                owner learns that a Private recipe will not appear to the
                people they share the cookbook with. A non-owner is never
                shown a status claim about somebody else's recipe. Meal plan
                (REW-89) follows the same owner-only rule, for the same
                reason -- /m/:id hides Private recipes exactly as /c/:id does.
              %>
              <% if (recipe.status === 'draft') { %>
                <span class="badge-draft badge-draft-sm">Private</span>
              <% } else { %>
                <span class="badge-published badge-published-sm">Public</span>
              <% } %>
              <% } %>
            </div>
          </div>

          <% if (recipe.author) { %>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">By <%= recipe.author %></p>
          <% } %>
          <% if (showAdaptedFrom && recipe.original_author) { %>
            <p style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">Adapted from <%= recipe.original_author %></p>
          <% } %>

          <!-- Category badges -->
          <% if (recipe.categories && recipe.categories.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
              <% recipe.categories.forEach(cat => { %>
                <% if (!chipsAreLinks) { %>
                <span class="category-badge" title="<%= cat.name %>"><span><%= cat.icon %></span> <%= cat.name %></span>
                <% } else { %>
                <a href="/recipes?category=<%= cat.slug %>" class="category-badge" title="<%= cat.name %>">
                  <span><%= cat.icon %></span> <%= cat.name %>
                </a>
                <% } %>
              <% }); %>
            </div>
          <% } %>

          <!-- Tags -->
          <% if (recipe.tags && recipe.tags.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem;">
              <% recipe.tags.forEach(tag => { %>
                <% if (!chipsAreLinks) { %>
                <span class="tag-badge"><%= tag.name %></span>
                <% } else { %>
                <a href="/recipes?tags=<%= tag.slug %>" class="tag-badge"><%= tag.name %></a>
                <% } %>
              <% }); %>
            </div>
          <% } %>

          <%#
            REW-86: "Label: value" metadata, matching the format the Browse
            cards use for the same recipe. Each field keeps its own
            "omit when empty" guard, so an empty field renders no stray label.
          %>
          <div class="recipe-summary-metadata" style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">
            <% if (recipe.prep_time) { %>
              <span>Prep Time: <%= recipe.prep_time %></span>
            <% } %>
            <% if (recipe.cook_time) { %>
              <span>Cook Time: <%= recipe.cook_time %></span>
            <% } %>
            <% if (recipe.servings) { %>
              <span>Servings: <%= recipe.servings %></span>
            <% } %>
            <% if (recipe.difficulty) { %>
              <span>Difficulty: <%= recipe.difficulty %></span>
            <% } %>
          </div>

          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.75rem; margin-bottom: 0.75rem;">
            Created <%= new Date(recipe.created_at).toLocaleDateString() %>
          </p>

          <% if (isBrowse) { %>
          <div class="recipe-card-actions" style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <% if (showMealPlanAdd) { %><button type="button" class="btn btn-outline meal-plan-add-btn<%= viewer ? '' : ' meal-plan-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Meal Plan' : 'Log in to add to Meal Plan' %>">+ Meal Plan</button><% } %>
          </div>
          <% } else if (isFavorites) { %>
          <%#
            REW-87 My Favorites action row. Same controls and same classes as
            the REW-86 owner row, minus the Private/Public toggle (every
            recipe here is already Public) and minus Edit/Delete unless the
            viewer actually owns this one.

            It carries `margin-top: auto` itself because there is no
            visibility control above it to hold the card's bottom spacing --
            without it, action rows would not line up across a grid row.

            `+ Cookbook` is rendered for every favorite, owned or not, per the
            ticket's acceptance criteria. Adding a recipe you do not own is
            still rejected by the API and by RLS today; REW-100 lifts that.
            The failure is already surfaced as an error toast by
            toggleCookbookMembership in public/js/cookbooks.js.
          %>
          <div class="recipe-card-actions recipe-summary-actions" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <% if (showMealPlanAdd) { %><button type="button" class="btn btn-outline meal-plan-add-btn<%= viewer ? '' : ' meal-plan-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Meal Plan' : 'Log in to add to Meal Plan' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Meal Plan</button><% } %>
            <% if (showCookbookAdd) { %><button type="button" class="btn btn-outline cookbook-add-btn<%= viewer ? '' : ' cookbook-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Cookbook' : 'Log in to add to Cookbook' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Cookbook</button><% } %>
            <%#
              Same deliberately inert Share placeholder REW-86 ships: no href,
              no handler, no endpoint, no target URL. Real sharing is REW-18.
            %>
            <button type="button" class="btn btn-outline recipe-share-btn" disabled aria-disabled="true" title="Sharing is coming soon" aria-label="Share (coming soon)" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">Share</button>
            <% if (showOwnerControls) { %>
            <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="width: 100%; background-color: var(--error-color); color: white; border-color: var(--error-color); font-size: 0.875rem; padding: 0.5rem 1rem;">Delete</button>
            </form>
            <% } %>
          </div>
          <% } else if (isCookbook) { %>
          <%#
            REW-88 cookbook action row. Same controls and the same classes as
            the REW-87 favorites row, with two deliberate differences:
            `+ Cookbook` is gone (this recipe is already in a cookbook, see
            showCookbookAdd above) and the page-specific Remove-from-cookbook
            form is carried in from views/cookbooks/view.ejs.

            The order is deliberate: Edit sits between Remove and Delete so
            "take this out of the cookbook" and "destroy this recipe forever"
            are never adjacent taps. Delete stays last, stays the only red
            control, and the two confirm dialogs read differently.

            `margin-top: auto` is carried here for the same reason as on
            favorites: there is no visibility control above it to hold the
            card's bottom spacing, and without it the action rows would not
            line up across a grid row.
          %>
          <div class="recipe-card-actions recipe-summary-actions" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <% if (showMealPlanAdd) { %><button type="button" class="btn btn-outline meal-plan-add-btn<%= viewer ? '' : ' meal-plan-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Meal Plan' : 'Log in to add to Meal Plan' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Meal Plan</button><% } %>
            <%#
              The same deliberately inert Share placeholder REW-86 and REW-87
              ship: no href, no handler, no endpoint, no target URL. Real
              sharing behavior is owned by REW-18. It must never link to
              /r/:id, which would be wrong and misleading for a Private
              recipe sitting in a cookbook.
            %>
            <button type="button" class="btn btn-outline recipe-share-btn" disabled aria-disabled="true" title="Sharing is coming soon" aria-label="Share (coming soon)" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">Share</button>
            <%#
              Remove is the page-specific action this surface has to preserve:
              it is the only way to get a recipe back out of a cookbook, and
              it never deletes the recipe itself. Rendered only when the
              caller supplied a cookbook id, so a caller that forgets degrades
              to no button rather than to a broken URL. Enforcement is
              unchanged server side -- POST /cookbooks/:id/recipes/:recipeId/remove
              keeps requireAuth, cookbookLimiter, its UUID guards and its
              cookbook-owner check.
            %>
            <% if (cardCookbookId) { %>
            <form action="/cookbooks/<%= cardCookbookId %>/recipes/<%= recipe.id %>/remove" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Remove this recipe from the cookbook? The recipe itself will not be deleted.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="cookbook">
              <button type="submit" class="btn btn-outline" style="width: 100%; font-size: 0.875rem; padding: 0.5rem 1rem;">Remove</button>
            </form>
            <% } %>
            <% if (showOwnerControls) { %>
            <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="width: 100%; background-color: var(--error-color); color: white; border-color: var(--error-color); font-size: 0.875rem; padding: 0.5rem 1rem;">Delete</button>
            </form>
            <% } %>
          </div>
          <% } else if (isMealPlan) { %>
          <%#
            REW-89 meal plan action row. Deliberately its own branch rather
            than a parameterized merge with the cookbook branch above: the
            consolidation is tempting, but the two differ in enough small ways
            (which add-button is suppressed, the Remove URL, the confirm copy,
            the absence of returnTo) that merging them would risk regressing
            REW-88 for no user-visible gain. Explicit per-surface branches are
            the established style here.

            Differences from the cookbook row: `+ Meal Plan` is gone (this
            recipe is already in a meal plan, see showMealPlanAdd above) and
            `+ Cookbook` is present, because a meal plan recipe may well not be
            in a cookbook yet.

            The order is deliberate, and matches REW-88: Edit sits between
            Remove and Delete so "take this out of the plan" and "destroy this
            recipe forever" are never adjacent taps. Delete stays last, stays
            the only red control, and the two confirm dialogs read differently.

            `margin-top: auto` is carried here for the same reason as on
            favorites and cookbook: there is no visibility control above it to
            hold the card's bottom spacing, and without it the action rows
            would not line up across a grid row.
          %>
          <div class="recipe-card-actions recipe-summary-actions" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <% if (showCookbookAdd) { %><button type="button" class="btn btn-outline cookbook-add-btn<%= viewer ? '' : ' cookbook-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Cookbook' : 'Log in to add to Cookbook' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Cookbook</button><% } %>
            <%#
              The same deliberately inert Share placeholder REW-86, REW-87 and
              REW-88 ship: no href, no handler, no endpoint, no target URL.
              Real sharing behavior is owned by REW-18. It must never link to
              /r/:id, which would be wrong and misleading for a Private recipe
              sitting in a meal plan.
            %>
            <button type="button" class="btn btn-outline recipe-share-btn" disabled aria-disabled="true" title="Sharing is coming soon" aria-label="Share (coming soon)" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">Share</button>
            <%#
              Remove is the page-specific action this surface has to preserve:
              it is the only way to get a recipe back out of a meal plan, and
              it never deletes the recipe itself. Rendered only when the caller
              supplied a meal plan id, so a caller that forgets degrades to no
              button rather than to a broken URL. No returnTo field, unlike the
              cookbook form -- POST /meal-plans/:id/recipes/:recipeId/remove
              always redirects back to /meal-plans/:id. Enforcement is
              unchanged server side: that route keeps requireAuth,
              mealPlanLimiter, its two UUID guards and its plan-owner check.
            %>
            <% if (cardMealPlanId) { %>
            <form action="/meal-plans/<%= cardMealPlanId %>/recipes/<%= recipe.id %>/remove" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Remove this recipe from the meal plan? The recipe itself will not be deleted.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline" style="width: 100%; font-size: 0.875rem; padding: 0.5rem 1rem;">Remove</button>
            </form>
            <% } %>
            <%#
              Owner-gated, and load-bearing in production TODAY rather than in
              anticipation of REW-100: a meal plan can genuinely hold another
              user's published recipe (migration 012's RLS INSERT policy), so
              this is the first surface where a non-owned card is the normal
              case. The flag is presentational; /recipes/:id/edit, /:id/update
              and /:id/delete each enforce ownership themselves.
            %>
            <% if (showOwnerControls) { %>
            <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="width: 100%; background-color: var(--error-color); color: white; border-color: var(--error-color); font-size: 0.875rem; padding: 0.5rem 1rem;">Delete</button>
            </form>
            <% } %>
          </div>
          <% } else { %>
          <%#
            REW-86 owner-only Private/Public toggle. A plain form POST +
            redirect rather than AJAX: flipping to Private must also disable
            the favorite heart above (favorites require status = 'published'),
            and a full re-render gets that consistency for free.

            `visibility` carries the opposite of the current state and follows
            the REW-85 private|public form convention; the server re-normalizes
            it fail-closed, so a tampered value can only ever land on Private.

            category/tags are round-tripped so the redirect can restore the
            active filter. They are whitelisted field names on a hard-coded
            /recipes path server-side -- no caller-supplied return URL is ever
            accepted (see buildRecipesListPath in recipeRoutes.js).
          %>
          <form class="recipe-visibility-control" action="/recipes/<%= recipe.id %>/visibility" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="category" value="<%= typeof selectedCategory !== 'undefined' ? selectedCategory : '' %>">
            <input type="hidden" name="tags" value="<%= typeof selectedTags !== 'undefined' ? selectedTags : '' %>">
            <span class="recipe-visibility-label">Visibility</span>
            <% if (recipe.status === 'published') { %>
              <span class="badge-published badge-published-sm">Public</span>
              <input type="hidden" name="visibility" value="private">
              <button type="submit" class="btn btn-outline recipe-visibility-btn" aria-label="Make <%= recipe.title %> Private">Make Private</button>
            <% } else { %>
              <span class="badge-draft badge-draft-sm">Private</span>
              <input type="hidden" name="visibility" value="public">
              <button type="submit" class="btn btn-outline recipe-visibility-btn" aria-label="Make <%= recipe.title %> Public">Make Public</button>
            <% } %>
          </form>

          <!-- Action buttons -->
          <%#
            No `margin-top: auto` here on the owner branch: the visibility
            control above carries it, so the control + actions sit together
            at the bottom of the card instead of being split by the gap.
          %>
          <div class="recipe-card-actions recipe-summary-actions" style="display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <% if (showMealPlanAdd) { %><button type="button" class="btn btn-outline meal-plan-add-btn<%= viewer ? '' : ' meal-plan-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Meal Plan' : 'Log in to add to Meal Plan' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Meal Plan</button><% } %>
            <% if (showCookbookAdd) { %><button type="button" class="btn btn-outline cookbook-add-btn<%= viewer ? '' : ' cookbook-add-btn-guest' %>" data-recipe-id="<%= recipe.id %>" aria-label="<%= viewer ? 'Add to Cookbook' : 'Log in to add to Cookbook' %>" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">+ Cookbook</button><% } %>
            <%#
              REW-86 ships the Share control as a deliberately inert
              placeholder: no href, no handler, no endpoint. Real sharing
              behavior is owned by REW-18. It must never link to /r/:id,
              which would be wrong (and misleading) for a Private recipe.
            %>
            <button type="button" class="btn btn-outline recipe-share-btn" disabled aria-disabled="true" title="Sharing is coming soon" aria-label="Share (coming soon)" style="flex: 1; font-size: 0.875rem; padding: 0.5rem 1rem;">Share</button>
            <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="width: 100%; background-color: var(--error-color); color: white; border-color: var(--error-color); font-size: 0.875rem; padding: 0.5rem 1rem;">Delete</button>
            </form>
          </div>
          <% } %>
        </div>

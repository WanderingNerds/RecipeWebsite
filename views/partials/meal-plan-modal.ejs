<!-- Add to Meal Plan Modal (REW-63) -->
<!-- Static modal markup included once in the layout (gated on `user`),
     wired up by public/js/meal-plans.js -- structurally modeled on
     views/partials/import-modal.ejs (same inline-style convention; this
     repo has no first-class `.modal` CSS class yet). -->
<div id="mealPlanModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 1000; align-items: center; justify-content: center;">
  <div class="modal-content" style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15); max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h3 style="margin: 0;">Add to Meal Plan</h3>
      <button type="button" id="closeMealPlanModal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>

    <p id="mealPlanModalStatus" style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;"></p>

    <div id="mealPlanModalList" style="margin-bottom: 1rem;"></div>

    <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
      <button type="button" id="mealPlanModalNewToggle" class="btn btn-outline" style="width: 100%; margin-bottom: 0.75rem;">+ New meal plan</button>

      <form id="mealPlanModalNewForm" style="display: none;">
        <div class="form-group">
          <label>Title <span style="color: var(--error-color);">*</span></label>
          <input type="text" id="mealPlanModalTitle" name="title" placeholder="e.g. Week of Sept 8" required maxlength="200">
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <div class="form-group" style="flex: 1;">
            <label>Start date <span style="color: var(--error-color);">*</span></label>
            <input type="date" id="mealPlanModalStartDate" name="startDate" required>
          </div>
          <div class="form-group" style="flex: 1;">
            <label>End date <span style="color: var(--error-color);">*</span></label>
            <input type="date" id="mealPlanModalEndDate" name="endDate" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Create &amp; Add Recipe</button>
      </form>
    </div>

  </div>
</div>

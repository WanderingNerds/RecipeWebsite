<% if (totalPages > 1) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (page > 1) { %>
      <a class="pagination-link" href="<%= baseHref %>page=<%= page - 1 %>" rel="prev">← Previous</a>
    <% } else { %>
      <span class="pagination-link is-disabled">← Previous</span>
    <% } %>

    <span class="pagination-status">Page <%= page %> of <%= totalPages %></span>

    <% if (page < totalPages) { %>
      <a class="pagination-link" href="<%= baseHref %>page=<%= page + 1 %>" rel="next">Next →</a>
    <% } else { %>
      <span class="pagination-link is-disabled">Next →</span>
    <% } %>
  </nav>
<% } %>

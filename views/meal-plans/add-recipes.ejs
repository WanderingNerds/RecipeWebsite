<div class="container" style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <a href="/meal-plans/<%= mealPlan.id %>" style="color: var(--primary-color); text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 1rem;">
      ← Back to <%= mealPlan.title %>
    </a>
    <h1 style="margin-bottom: 0.5rem;">Add Recipes to <%= mealPlan.title %></h1>
    <p style="color: var(--text-muted);">Select from your own recipes to add. Recipes already in this meal plan are checked and can be removed from the plan's page. To add another user's Public recipe, use "Add to Meal Plan" on that recipe's card or page instead.</p>
  </div>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>You don't have any recipes yet</h3>
      <p>Create a recipe first, then come back to add it to this meal plan.</p>
      <a href="/recipes/new" class="btn btn-primary">Add New Recipe</a>
    </div>
  <% } else { %>
    <form action="/meal-plans/<%= mealPlan.id %>/add-recipes" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="margin-bottom: 1rem;">
        <label for="meal-plan-recipe-search" style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Search recipes</label>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <input
            type="search"
            id="meal-plan-recipe-search"
            class="input"
            placeholder="Search by recipe name"
            autocomplete="off"
            aria-controls="meal-plan-recipe-list"
          >
          <button type="button" id="meal-plan-recipe-search-clear" class="btn btn-outline" hidden>Clear search</button>
        </div>
        <p id="meal-plan-recipe-search-status" role="status" aria-live="polite" style="color: var(--text-muted); font-size: 0.875rem; margin: 0.5rem 0 0;"></p>
      </div>
      <div id="meal-plan-recipe-list" style="background: var(--card-background); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; margin-bottom: 1.5rem;">
        <% recipes.forEach(function(recipe, index) { %>
          <label data-recipe-search-item data-recipe-title="<%= recipe.title %>" style="display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem; cursor: <%= recipe.inMealPlan ? 'default' : 'pointer' %>; <%= index !== recipes.length - 1 ? 'border-bottom: 1px solid var(--border-color);' : '' %> <%= recipe.inMealPlan ? 'opacity: 0.6;' : '' %>">
            <input
              type="checkbox"
              name="recipeIds"
              value="<%= recipe.id %>"
              <%= recipe.inMealPlan ? 'checked disabled' : '' %>
              style="width: 1.125rem; height: 1.125rem; flex-shrink: 0;"
            >
            <span style="flex: 1;">
              <span style="font-weight: 600;"><%= recipe.title %></span>
              <% if (recipe.status === 'draft') { %>
                <span class="badge-draft badge-draft-sm" style="margin-left: 0.5rem;">Private</span>
              <% } %>
            </span>
            <% if (recipe.inMealPlan) { %>
              <span style="font-size: 0.8125rem; color: var(--text-muted);">Already added</span>
            <% } %>
          </label>
        <% }); %>
      </div>
      <div id="meal-plan-recipe-search-empty" class="empty-state" hidden>
        <h3>No recipes found</h3>
        <p>Try a different recipe name or clear your search.</p>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 1rem;">
        <a href="/meal-plans/<%= mealPlan.id %>" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Add Selected Recipes</button>
      </div>
    </form>
  <% } %>

</div>
<script type="module" src="/js/meal-plan-recipe-search.js"></script>

<div class="container" style="max-width: 1200px; padding: 2rem 1rem;">

  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2rem;">
    <div>
      <h1>My Meal Plans</h1>
      <p style="color: var(--text-muted);">Plan what you're going to cook for a scheduled period of time</p>
    </div>
    <a href="/meal-plans/new" class="btn btn-primary">New Meal Plan</a>
  </div>

  <% if (mealPlans.length === 0) { %>
    <div class="empty-state">
      <h3>No meal plans yet</h3>
      <p>Create a meal plan to organize what you're going to cook during a specific week, holiday, or trip.</p>
      <a href="/meal-plans/new" class="btn btn-primary">Create Your First Meal Plan</a>
    </div>
  <% } else { %>
    <p class="result-count"><%= mealPlans.length %> meal plan<%= mealPlans.length !== 1 ? 's' : '' %></p>

    <div class="recipe-grid-fill">
      <% mealPlans.forEach(function(mealPlan) { %>
        <div class="feature-card" style="position: relative; display: flex; flex-direction: column;">
          <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; margin-bottom: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="/meal-plans/<%= mealPlan.id %>" style="color: inherit; text-decoration: none;">
                <%= mealPlan.title %>
              </a>
            </h3>
            <span class="meal-plan-count-badge"><%= mealPlan.recipeCount %> recipe<%= mealPlan.recipeCount !== 1 ? 's' : '' %></span>
          </div>

          <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem; margin-bottom: 0.75rem;">
            <%= new Date(mealPlan.start_date + 'T00:00:00').toLocaleDateString() %> &ndash; <%= new Date(mealPlan.end_date + 'T00:00:00').toLocaleDateString() %>
          </p>

          <div style="display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <a href="/meal-plans/<%= mealPlan.id %>" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">View</a>
            <a href="/meal-plans/<%= mealPlan.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

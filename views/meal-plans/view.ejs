<div class="container" style="max-width: 1200px; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <a href="/meal-plans" style="color: var(--primary-color); text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 1rem;">
      ← Back to meal plans
    </a>

    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <h1 style="margin-bottom: 0.5rem;"><%= mealPlan.title %></h1>
        <p style="color: var(--text-muted); margin-bottom: 0.25rem;">
          <%= new Date(mealPlan.start_date + 'T00:00:00').toLocaleDateString() %> &ndash; <%= new Date(mealPlan.end_date + 'T00:00:00').toLocaleDateString() %>
        </p>
        <p style="color: var(--text-muted);"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %></p>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <%#
          REW-69 plan-level sharing control. Deliberately a labelled control
          here in the header, NOT another bare badge, so it reads as distinct
          from the per-recipe Private/Public pills on the cards below.
          `visibility` follows the REW-85 private|public form convention and is
          re-normalized fail-closed server side.
        %>
        <form class="meal-plan-visibility-control" action="/meal-plans/<%= mealPlan.id %>/visibility" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="meal-plan-visibility-label">Meal plan</span>
          <% if (mealPlan.is_public) { %>
            <span class="meal-plan-visibility-badge meal-plan-visibility-public">Public</span>
            <input type="hidden" name="visibility" value="private">
            <button type="submit" class="btn btn-outline" style="font-size: 0.875rem; padding: 0.5rem 1rem;">Make Private</button>
          <% } else { %>
            <span class="meal-plan-visibility-badge meal-plan-visibility-private">Private</span>
            <input type="hidden" name="visibility" value="public">
            <button type="submit" class="btn btn-outline" style="font-size: 0.875rem; padding: 0.5rem 1rem;">Make Public</button>
          <% } %>
        </form>
        <a href="/meal-plans/<%= mealPlan.id %>/add-recipes" class="btn btn-primary">Add Recipes</a>
        <% if (recipes.length > 0) { %>
          <a href="/meal-plans/<%= mealPlan.id %>/grocery-list" class="btn btn-outline">Grocery List</a>
        <% } %>
        <a href="/meal-plans/<%= mealPlan.id %>/edit" class="btn btn-outline">Edit</a>
        <form action="/meal-plans/<%= mealPlan.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this meal plan? Its recipes will not be deleted.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn" style="background-color: var(--error-color); color: white; border-color: var(--error-color);">Delete Meal Plan</button>
        </form>
      </div>
    </div>
  </div>

  <%#
    Share link, shown only while the meal plan is Public. `appUrl` comes from
    getAppUrl() in the route -- never from the request Host header, because
    this string exists to be copied and re-shared. Guarded with typeof so
    templates rendered directly in tests (without appUrl) still render.
  %>
  <% if (mealPlan.is_public && typeof appUrl !== 'undefined' && appUrl) { %>
    <div class="meal-plan-share-panel" data-meal-plan-share>
      <p class="meal-plan-share-panel-label">Anyone with this link can view this meal plan and its Public recipes.</p>
      <input
        type="text"
        class="meal-plan-share-url"
        data-meal-plan-share-url
        value="<%= appUrl %>/m/<%= mealPlan.id %>"
        readonly
        aria-label="Share link for this meal plan"
      >
      <button type="button" class="btn btn-outline" data-meal-plan-share-copy>Copy link</button>
      <span class="meal-plan-share-feedback" data-meal-plan-share-feedback role="status" aria-live="polite"></span>
    </div>
  <% } %>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>No recipes in this meal plan yet</h3>
      <p>Add some recipes to start planning what you'll cook.</p>
      <a href="/meal-plans/<%= mealPlan.id %>/add-recipes" class="btn btn-primary">Add Recipes</a>
    </div>
  <% } else { %>
    <div class="organization-card-grid">
      <% recipes.forEach(function(recipe) { %>
        <div class="feature-card" style="position: relative; display: flex; flex-direction: column;">
          <% if (recipe.thumbnail_url) { %>
            <a href="/recipes/<%= recipe.id %>" style="display: block; margin-bottom: 1rem;">
              <div class="photo-placeholder" style="width: 100%; height: 200px; border-radius: var(--radius); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <img src="<%= recipe.thumbnail_url %>" alt="<%= recipe.title %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            </a>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem; gap: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="/recipes/<%= recipe.id %>" style="color: inherit; text-decoration: none;">
                <%= recipe.title %>
              </a>
            </h3>
            <% if (recipe.status === 'draft') { %>
              <span class="badge-draft badge-draft-sm">Private</span>
            <% } else { %>
              <span class="badge-published badge-published-sm">Public</span>
            <% } %>
          </div>

          <% if (recipe.author) { %>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">By <%= recipe.author %></p>
          <% } %>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">
            <% if (recipe.prep_time) { %>
              <span>Prep: <%= recipe.prep_time %></span>
            <% } %>
            <% if (recipe.cook_time) { %>
              <span>Cook: <%= recipe.cook_time %></span>
            <% } %>
            <% if (recipe.servings) { %>
              <span><%= recipe.servings %> servings</span>
            <% } %>
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <form action="/meal-plans/<%= mealPlan.id %>/recipes/<%= recipe.id %>/remove" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Remove this recipe from the meal plan? The recipe itself will not be deleted.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline" style="width: 100%; font-size: 0.875rem; padding: 0.5rem 1rem;">Remove</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<script src="/js/meal-plan-share.js"></script>

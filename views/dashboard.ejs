<section class="dashboard">
  <h1>Dashboard</h1>
  <p>Welcome back, <strong><%= user.user_metadata?.name || user.email %></strong>!</p>

  <div class="dashboard-info">
    <h2>Your Account</h2>
    <div class="info-card">
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Email Verified:</strong> <%= user.email_confirmed_at ? 'Yes' : 'No' %></p>
      <p><strong>Member since:</strong> <%= new Date(user.created_at).toLocaleDateString() %></p>
    </div>
  </div>

  <div class="dashboard-actions">
    <h2>Quick Actions</h2>
    <div class="quick-actions-grid">
      <a class="quick-action-card quick-action-card--recipes" href="/recipes">
        <span class="quick-action-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
          </svg>
        </span>
        <span class="quick-action-card__content">
          <span class="quick-action-card__title">My Recipes</span>
          <span class="quick-action-card__description">Browse and manage your recipe collection.</span>
        </span>
      </a>

      <a class="quick-action-card quick-action-card--cookbooks" href="/cookbooks">
        <span class="quick-action-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v14a2.5 2.5 0 0 0-2.5-2.5H2Z" />
            <path d="M22 6a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v14a2.5 2.5 0 0 1 2.5-2.5H22Z" />
          </svg>
        </span>
        <span class="quick-action-card__content">
          <span class="quick-action-card__title">My Cookbooks</span>
          <span class="quick-action-card__description">Organize recipes into personal cookbooks.</span>
        </span>
      </a>

      <a class="quick-action-card quick-action-card--favorites" href="/recipes/liked">
        <span class="quick-action-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" />
          </svg>
        </span>
        <span class="quick-action-card__content">
          <span class="quick-action-card__title">My Favorites</span>
          <span class="quick-action-card__description">Return to recipes you have liked.</span>
        </span>
      </a>

      <a class="quick-action-card quick-action-card--meal-plans" href="/meal-plans">
        <span class="quick-action-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
          </svg>
        </span>
        <span class="quick-action-card__content">
          <span class="quick-action-card__title">My Meal Plans</span>
          <span class="quick-action-card__description">Plan upcoming meals in one place.</span>
        </span>
      </a>
    </div>
  </div>
</section>

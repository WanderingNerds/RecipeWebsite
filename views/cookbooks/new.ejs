<div class="container" style="max-width: 600px; margin: 0 auto; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <span class="badge-new" style="display: inline-block; margin-bottom: 1rem;">New cookbook</span>
    <h1 style="margin-bottom: 0.5rem;">Create a cookbook</h1>
    <p style="color: var(--text-muted);">Give your cookbook a name. You can add recipes to it right after.</p>
  </div>

  <form action="/cookbooks" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">

      <div class="form-group">
        <label>Title <span style="color: var(--error-color);">*</span></label>
        <input type="text" name="title" placeholder="e.g. Weeknight Dinners" required maxlength="200" autofocus>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color); margin-top: 1rem;">
        <a href="/cookbooks" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Cookbook</button>
      </div>

    </div>
  </form>

</div>

<div class="container" style="max-width: 1200px; padding: 2rem 1rem;">

  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2rem;">
    <div>
      <h1>My Cookbooks</h1>
      <p style="color: var(--text-muted);">Organize your recipes into named collections</p>
    </div>
    <a href="/cookbooks/new" class="btn btn-primary">New Cookbook</a>
  </div>

  <% if (cookbooks.length === 0) { %>
    <div class="empty-state">
      <h3>No cookbooks yet</h3>
      <p>Create a cookbook to start grouping your recipes -- weeknight dinners, holiday favorites, anything you like.</p>
      <a href="/cookbooks/new" class="btn btn-primary">Create Your First Cookbook</a>
    </div>
  <% } else { %>
    <p class="result-count"><%= cookbooks.length %> cookbook<%= cookbooks.length !== 1 ? 's' : '' %></p>

    <div class="organization-card-grid">
      <% cookbooks.forEach(function(cookbook) { %>
        <div class="feature-card" style="position: relative; display: flex; flex-direction: column;">
          <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; margin-bottom: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="/cookbooks/<%= cookbook.id %>" style="color: inherit; text-decoration: none;">
                <%= cookbook.title %>
              </a>
            </h3>
            <span class="cookbook-count-badge"><%= cookbook.recipeCount %> recipe<%= cookbook.recipeCount !== 1 ? 's' : '' %></span>
          </div>

          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; margin-bottom: 0.75rem;">
            Created <%= new Date(cookbook.created_at).toLocaleDateString() %>
          </p>

          <div style="display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <a href="/cookbooks/<%= cookbook.id %>" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">View</a>
            <a href="/cookbooks/<%= cookbook.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Rename</a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

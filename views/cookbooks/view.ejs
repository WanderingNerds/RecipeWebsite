<div class="container" style="max-width: 1200px; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <a href="/cookbooks" style="color: var(--primary-color); text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 1rem;">
      ← Back to cookbooks
    </a>

    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <h1 style="margin-bottom: 0.5rem;"><%= cookbook.title %></h1>
        <p style="color: var(--text-muted);"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %></p>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/cookbooks/<%= cookbook.id %>/add-recipes" class="btn btn-primary">Add Recipes</a>
        <a href="/cookbooks/<%= cookbook.id %>/edit" class="btn btn-outline">Rename</a>
        <form action="/cookbooks/<%= cookbook.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this cookbook? Its recipes will not be deleted.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn" style="background-color: var(--error-color); color: white; border-color: var(--error-color);">Delete Cookbook</button>
        </form>
      </div>
    </div>
  </div>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>No recipes in this cookbook yet</h3>
      <p>Add some of your recipes to start building this collection.</p>
      <a href="/cookbooks/<%= cookbook.id %>/add-recipes" class="btn btn-primary">Add Recipes</a>
    </div>
  <% } else { %>
    <div class="recipe-grid-fill">
      <% recipes.forEach(function(recipe) { %>
        <div class="feature-card" style="position: relative; display: flex; flex-direction: column;">
          <% if (recipe.thumbnail_url) { %>
            <a href="/recipes/<%= recipe.id %>" style="display: block; margin-bottom: 1rem;">
              <div class="photo-placeholder" style="width: 100%; height: 200px; border-radius: var(--radius); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <img src="<%= recipe.thumbnail_url %>" alt="<%= recipe.title %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            </a>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem; gap: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="/recipes/<%= recipe.id %>" style="color: inherit; text-decoration: none;">
                <%= recipe.title %>
              </a>
            </h3>
            <% if (recipe.status === 'draft') { %>
              <span class="badge-draft badge-draft-sm">Draft</span>
            <% } else { %>
              <span class="badge-published badge-published-sm">Published</span>
            <% } %>
          </div>

          <% if (recipe.author) { %>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">By <%= recipe.author %></p>
          <% } %>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">
            <% if (recipe.prep_time) { %>
              <span>Prep: <%= recipe.prep_time %></span>
            <% } %>
            <% if (recipe.cook_time) { %>
              <span>Cook: <%= recipe.cook_time %></span>
            <% } %>
            <% if (recipe.servings) { %>
              <span><%= recipe.servings %> servings</span>
            <% } %>
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <a href="/recipes/<%= recipe.id %>" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">View</a>
            <form action="/cookbooks/<%= cookbook.id %>/recipes/<%= recipe.id %>/remove" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Remove this recipe from the cookbook? The recipe itself will not be deleted.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="cookbook">
              <button type="submit" class="btn btn-outline" style="width: 100%; font-size: 0.875rem; padding: 0.5rem 1rem;">Remove</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<section class="auth-container"><div class="auth-card"><p class="eyebrow">Restricted area</p><h1>Administrator Login</h1><p>Use an authorized administrator account.</p><form action="/admin/login" method="POST" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required></div><div class="form-group"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn btn-primary" type="submit">Sign in</button></form></div></section>

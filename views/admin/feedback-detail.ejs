<section class="admin-feedback"><a href="/admin/feedback">&larr; Back to queue</a><p class="eyebrow"><%= submission.category %></p><h1><%= submission.subject %></h1><span class="status-badge status-badge--<%= submission.status %>"><%= statusLabel(submission.status) %></span>
<dl class="submission-meta"><div><dt>Name</dt><dd><%= submission.contact_name %></dd></div><div><dt>Email</dt><dd><%= submission.contact_email %></dd></div><div><dt>Submitted</dt><dd><time datetime="<%= submission.created_at %>"><%= new Date(submission.created_at).toLocaleString() %></time></dd></div><div><dt>Assignee</dt><dd><%= submission.assignee?.display_name || 'Unassigned' %></dd></div></dl><article class="submission-message"><h2>Message</h2><p><%= submission.message %></p></article>
<form action="/admin/feedback/<%= submission.id %>" method="POST" class="admin-workflow-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="status">Status</label><select id="status" name="status"><% for (const value of statuses) { %><option value="<%= value %>" <%= submission.status === value ? 'selected' : '' %>><%= statusLabel(value) %></option><% } %></select></div><div class="form-group"><label for="assigneeId">Assignee</label><select id="assigneeId" name="assigneeId"><option value="">Unassigned</option><% for (const admin of admins) { %><option value="<%= admin.id %>" <%= submission.assignee_id === admin.id ? 'selected' : '' %>><%= admin.display_name %></option><% } %></select></div><button class="btn btn-primary" type="submit">Save changes</button></form></section>

<section class="admin-feedback"><p class="eyebrow">Administration</p><h1>Help &amp; Feedback</h1>
<% if (typeof loadError !== 'undefined') { %><div class="alert alert-error" role="alert"><%= loadError %></div><% } %>
<nav class="admin-filters" aria-label="Filter submissions"><% for (const option of filters) { %><a href="/admin/feedback?status=<%= option %>" class="btn <%= filter === option ? 'btn-primary' : 'btn-outline' %>" <%= filter === option ? 'aria-current="page"' : '' %>><%= option === 'all' ? 'All' : option === 'done' ? 'Done' : 'Unresolved' %></a><% } %></nav>
<% if (!submissions.length) { %><div class="empty-state"><h2>No submissions</h2></div><% } else { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Status</th><th>Subject</th><th>Submitter</th><th>Category</th><th>Assignee</th><th>Submitted</th></tr></thead><tbody><% for (const item of submissions) { %><tr class="status-row--<%= item.status %>"><td><span class="status-badge status-badge--<%= item.status %>"><%= statusLabel(item.status) %></span></td><td><a href="/admin/feedback/<%= item.id %>"><%= item.subject %></a></td><td><%= item.contact_name %><br><small><%= item.contact_email %></small></td><td><%= item.category %></td><td><%= item.assignee?.display_name || 'Unassigned' %></td><td><time datetime="<%= item.created_at %>"><%= new Date(item.created_at).toLocaleString() %></time></td></tr><% } %></tbody></table></div><% } %></section>

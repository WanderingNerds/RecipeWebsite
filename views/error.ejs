<section class="error-page">
  <h1><%= error.status || 500 %></h1>
  <h2><%= message %></h2>
  <p>
    <a href="/" class="btn btn-primary">Go Home</a>
  </p>

  <% if (error.stack && process.env.NODE_ENV !== 'production') { %>
    <details class="error-details">
      <summary>Error Details</summary>
      <pre><%= error.stack %></pre>
    </details>
  <% } %>
</section>

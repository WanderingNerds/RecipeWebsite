<div class="container" style="max-width: 900px; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <a href="/recipes" style="color: var(--primary-color); text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 1rem;">
      ← Back to recipes
    </a>

    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <h1 style="margin-bottom: 0.5rem;"><%= recipe.title %></h1>
        <% if (recipe.author) { %>
          <p style="color: var(--text-muted);">By <%= recipe.author %></p>
        <% } %>
      </div>
      <div style="display: flex; align-items: center; gap: 1rem;">
        <% if (recipe.status === 'published') { %>
          <button class="like-btn" data-recipe-id="<%= recipe.id %>" data-liked="<%= isLiked %>" aria-label="<%= isLiked ? 'Unlike this recipe' : 'Like this recipe' %>">
            <span class="like-btn-icon">&#9829;</span>
            <span class="like-btn-count"><%= likeCount %></span>
          </button>
        <% } %>
        <% if (recipe.status === 'draft') { %>
          <span class="badge-draft">Draft</span>
        <% } else { %>
          <span class="badge-published">Published</span>
        <% } %>
      </div>
    </div>

    <!-- Categories and Tags -->
    <% if ((recipe.categories && recipe.categories.length > 0) || (recipe.tags && recipe.tags.length > 0)) { %>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
        <% if (recipe.categories && recipe.categories.length > 0) { %>
          <% recipe.categories.forEach(cat => { %>
            <a href="/recipes?category=<%= cat.slug %>" class="category-badge category-badge-lg">
              <span><%= cat.icon %></span> <%= cat.name %>
            </a>
          <% }); %>
        <% } %>
        <% if (recipe.tags && recipe.tags.length > 0) { %>
          <% recipe.tags.forEach(tag => { %>
            <a href="/recipes?tags=<%= tag.slug %>" class="tag-badge tag-badge-lg"><%= tag.name %></a>
          <% }); %>
        <% } %>
      </div>
    <% } %>

    <% if (isOwner) { %>
      <div style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
        <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline">Edit Recipe</a>
        <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn" style="background-color: var(--error-color); color: white; border-color: var(--error-color);">Delete Recipe</button>
        </form>
      </div>

      <!-- Save to Cookbook(s) (REW-62) -->
      <div style="margin-bottom: 1rem; padding: 1rem 1.25rem; background: var(--card-background); border-radius: var(--radius); box-shadow: var(--shadow);">
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem;">Save to Cookbook(s)</h3>

        <% if (ownerCookbooks.length === 0) { %>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin: 0;">
            You don't have any cookbooks yet. <a href="/cookbooks/new">Create one</a> to start organizing your recipes.
          </p>
        <% } else { %>
          <% var savedCookbooks = ownerCookbooks.filter(function(cb) { return cb.containsRecipe; }); %>
          <% var availableCookbooks = ownerCookbooks.filter(function(cb) { return !cb.containsRecipe; }); %>

          <% if (savedCookbooks.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: <%= availableCookbooks.length > 0 ? '0.75rem' : '0' %>;">
              <% savedCookbooks.forEach(function(cb) { %>
                <span class="tag-badge cookbook-badge">
                  <a href="/cookbooks/<%= cb.id %>"><%= cb.title %></a>
                  <form action="/cookbooks/<%= cb.id %>/recipes/<%= recipe.id %>/remove" method="POST" style="margin: 0; display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="returnTo" value="recipe">
                    <button type="submit" class="cookbook-remove-btn" aria-label="Remove from <%= cb.title %>" title="Remove from <%= cb.title %>">&times;</button>
                  </form>
                </span>
              <% }); %>
            </div>
          <% } %>

          <% if (availableCookbooks.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <% availableCookbooks.forEach(function(cb) { %>
                <form action="/cookbooks/<%= cb.id %>/recipes/<%= recipe.id %>" method="POST" style="margin: 0; display: inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-outline" style="font-size: 0.8125rem; padding: 0.375rem 0.75rem;">+ Add to <%= cb.title %></button>
                </form>
              <% }); %>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </div>

  <div style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">

    <!-- Recipe photo -->
    <% if (recipe.photo_url) { %>
      <div class="photo-placeholder" style="margin-bottom: 2rem; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; min-height: 300px;">
        <img src="<%= recipe.photo_url %>" alt="<%= recipe.title %>" style="width: 100%; max-height: 400px; object-fit: contain; border-radius: var(--radius);">
      </div>
    <% } %>

    <!-- Recipe metadata -->
    <% if (recipe.prep_time || recipe.cook_time || recipe.servings || recipe.difficulty) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem; padding: 1.5rem; background: var(--background-color); border-radius: var(--radius); margin-bottom: 2rem;">
        <% if (recipe.prep_time) { %>
          <div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Prep Time</p>
            <p style="font-weight: 600; margin: 0;"><%= recipe.prep_time %></p>
          </div>
        <% } %>
        <% if (recipe.cook_time) { %>
          <div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Cook Time</p>
            <p style="font-weight: 600; margin: 0;"><%= recipe.cook_time %></p>
          </div>
        <% } %>
        <% if (recipe.servings) { %>
          <div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Servings</p>
            <% if (scaling.isScaled && scaling.canScaleByServings) { %>
              <p style="font-weight: 600; margin: 0;"><%= scaling.targetServingsText %></p>
              <p style="font-size: 0.8125rem; color: var(--text-muted); margin: 0.25rem 0 0 0;">originally <%= recipe.servings %></p>
            <% } else { %>
              <p style="font-weight: 600; margin: 0;"><%= recipe.servings %></p>
            <% } %>
          </div>
        <% } %>
        <% if (recipe.difficulty) { %>
          <div>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Difficulty</p>
            <p style="font-weight: 600; margin: 0;"><%= recipe.difficulty %></p>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Ingredients -->
    <% if (ingredientRows && ingredientRows.length) { %>
      <div style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
          <h2 style="font-size: 1.5rem; margin: 0; color: var(--primary-color);">Ingredients</h2>

          <div class="scale-control">
            <% if (scaling.canScaleByServings) { %>
              <span class="scale-label">Servings</span>
              <a class="scale-btn" href="/recipes/<%= recipe.id %>?servings=<%= scaling.stepDownServings %>" aria-label="Fewer servings">−</a>
              <form class="scale-servings-form" method="GET" action="/recipes/<%= recipe.id %>">
                <input class="scale-servings-input" type="number" name="servings" min="1" max="500" step="1"
                       value="<%= Math.max(1, Math.round(scaling.targetServings)) %>"
                       aria-label="Number of servings" title="Enter a number of servings and press Enter">
              </form>
              <a class="scale-btn" href="/recipes/<%= recipe.id %>?servings=<%= scaling.stepUpServings %>" aria-label="More servings">+</a>
            <% } else { %>
              <span class="scale-label">Scale</span>
              <% quickScaleFactors.forEach(function (factor) { %>
                <a class="scale-btn <%= scaling.factor === factor ? 'is-active' : '' %>"
                   href="/recipes/<%= recipe.id %><%= factor === 1 ? '' : '?scale=' + factor %>"><%= factor === 0.5 ? '½' : factor %>×</a>
              <% }); %>
            <% } %>

            <% if (scaling.isScaled) { %>
              <a class="scale-reset" href="/recipes/<%= recipe.id %>">Reset</a>
            <% } %>
          </div>
        </div>

        <% if (scaling.isScaled) { %>
          <p class="scale-notice">
            Scaled <%= scaling.factorText %>× from the original recipe<%= scaling.canScaleByServings ? ' (' + recipe.servings + ')' : '' %>.
            Amounts without a number, like "to taste", are unchanged.
          </p>
        <% } %>

        <ul class="ingredient-list">
          <% ingredientRows.forEach(function (row) { %>
            <% if (row.type === 'section') { %>
              <li class="ingredient-section"><%= row.ingredient %></li>
            <% } else { %>
              <li class="ingredient-row">
                <span class="ingredient-amount">
                  <span class="amount-primary"><%= row.primaryAmount %></span>
                  <% if (row.secondaryAmount) { %>
                    <span class="amount-secondary"><%= row.secondaryAmount %></span>
                  <% } %>
                </span>
                <span class="ingredient-name">
                  <%= row.ingredient %><% if (row.note) { %><span class="ingredient-note"> — <%= row.note %></span><% } %>
                </span>
              </li>
            <% } %>
          <% }); %>
        </ul>

        <% if (ingredientRows.some(function (row) { return row.grams !== null; })) { %>
          <p class="ingredient-footnote">
            Weights are converted using standard ingredient densities and are a guide, not a substitute for weighing.
          </p>
        <% } %>
      </div>
    <% } %>

    <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

    <!-- Instructions -->
    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--primary-color);">Instructions</h2>
      <div style="white-space: pre-line; line-height: 1.8;"><%= recipe.instructions %></div>
    </div>

    <!-- Tips & Notes -->
    <% if (recipe.notes) { %>
      <div class="callout-info" style="margin-top: 2rem;">
        <h3 style="font-size: 1.125rem; margin-bottom: 0.75rem;">Tips & Notes</h3>
        <div style="white-space: pre-line; line-height: 1.6;"><%= recipe.notes %></div>
      </div>
    <% } %>

    <!-- Footer -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); font-size: 0.875rem; color: var(--text-muted);">
      <p style="margin: 0;">Created on <%= new Date(recipe.created_at).toLocaleDateString() %></p>
      <% if (recipe.updated_at && recipe.updated_at !== recipe.created_at) { %>
        <p style="margin: 0.25rem 0 0 0;">Last updated on <%= new Date(recipe.updated_at).toLocaleDateString() %></p>
      <% } %>
    </div>

  </div>

</div>

<div class="page-narrow">

  <header class="page-header">
    <h1>Search Recipes</h1>
    <p class="page-subtitle">Find Public recipes from the whole community.</p>
  </header>

  <form class="search-form search-form-lg" action="/search" method="GET" role="search">
    <input
      type="search"
      name="q"
      value="<%= query %>"
      placeholder="Try &ldquo;chicken&rdquo;, &ldquo;30 minute pasta&rdquo;, or an ingredient&hellip;"
      aria-label="Search recipes"
      maxlength="100"
      autofocus
    >
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <%#
    REW-19: Public cookbooks are a secondary result surface. `cookbooks` is
    guarded with typeof so this template still renders for callers that pass
    only recipe locals.
  %>
  <% const cookbookResults = (typeof cookbooks !== 'undefined' && cookbooks) ? cookbooks : []; %>

  <% if (!query) { %>

    <div class="empty-state">
      <h3>What are you in the mood for?</h3>
      <p>Search by title, author, or ingredient — no account needed.</p>
      <a href="/browse" class="btn btn-outline">Browse all recipes</a>
    </div>

  <% } else if (recipes.length === 0 && cookbookResults.length === 0) { %>

    <div class="empty-state">
      <h3>No recipes match &ldquo;<%= query %>&rdquo;</h3>
      <p>Try a different spelling, a single ingredient, or fewer words.</p>
      <a href="/browse" class="btn btn-outline">Browse all recipes</a>
    </div>

  <% } else { %>

    <% if (recipes.length === 0) { %>

      <%# Matching cookbooks but no matching recipes: show the cookbooks
          rather than a dead-end "no results" page. %>
      <p class="result-count">
        No recipes match &ldquo;<%= query %>&rdquo;, but these cookbooks do.
      </p>

    <% } else { %>

      <p class="result-count">
        <%= totalCount %> <%= totalCount === 1 ? "recipe" : "recipes" %> matching &ldquo;<%= query %>&rdquo;
      </p>

      <div class="recipe-grid">
        <% recipes.forEach(recipe => { %>
          <%- include('../partials/recipe-card', { recipe }) %>
        <% }); %>
      </div>

      <%- include('../partials/pagination', {
        page,
        totalPages,
        baseHref: `/search?q=${encodeURIComponent(query)}&`
      }) %>

    <% } %>

    <% if (cookbookResults.length > 0) { %>
      <section class="cookbook-result-section">
        <h2 class="cookbook-result-heading">Cookbooks</h2>
        <ul class="cookbook-result-list">
          <% cookbookResults.forEach(cookbook => { %>
            <li class="cookbook-result-item">
              <a href="/c/<%= cookbook.id %>"><%= cookbook.title %></a>
              <span class="cookbook-count-badge"><%= cookbook.recipe_count %> recipe<%= Number(cookbook.recipe_count) !== 1 ? 's' : '' %></span>
            </li>
          <% }); %>
        </ul>
      </section>
    <% } %>

  <% } %>

</div>

<div class="container" style="max-width: 1000px; margin: 0 auto; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <a href="/recipes/<%= recipe.id %>" style="color: var(--primary-color); text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 1rem;">
      ← Back to recipe
    </a>
    <span class="badge-edit" style="display: inline-block; margin-bottom: 1rem;">Edit recipe</span>
    <h1 style="margin-bottom: 0.5rem;">Edit <%= recipe.title %></h1>
    <p style="color: var(--text-muted); max-width: 600px;">Update your recipe details. Only title and instructions are required.</p>
  </div>

  <form action="/recipes/<%= recipe.id %>/update" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">

      <!-- Two column layout for desktop, single column for mobile -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">

        <!-- Left column -->
        <div style="grid-column: 1 / -1;">
          <!-- Photo upload -->
          <div style="margin-bottom: 1.5rem;">
            <label for="photo" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Recipe Photo (optional)</label>
            <input type="file" id="photo" name="photo" accept="image/*" style="display: none;">
            <div id="photoPreview" class="<% if (recipe.photo_url) { %>photo-placeholder<% } else { %>photo-placeholder-pattern<% } %>" style="width: 100%; height: 200px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden;">
              <span id="photoPlaceholder" style="<% if (recipe.photo_url) { %>display: none;<% } %>background: white; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.875rem; color: var(--text-muted);">Click to upload photo of the finished dish</span>
              <img id="photoImage" src="<%= recipe.photo_url || '' %>" style="<% if (recipe.photo_url) { %>display: block;<% } else { %>display: none;<% } %> width: 100%; height: 100%; object-fit: contain;">
            </div>
            <% if (recipe.photo_url) { %>
              <div style="margin-top: 0.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
                  <input type="checkbox" name="removePhoto" value="true">
                  <span>Remove current photo</span>
                </label>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Basic Info Section -->
        <div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Basic Information</h3>

          <div class="form-group">
            <label>Title <span style="color: var(--error-color);">*</span></label>
            <input type="text" name="title" placeholder="e.g. Grandma's Sunday Sauce" required value="<%= recipe.title %>">
          </div>

          <div class="form-group">
            <label>Author</label>
            <input type="text" name="author" placeholder="Your name" value="<%= recipe.author || '' %>">
          </div>

          <!-- Meta fields grid -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label>Prep time</label>
              <input type="text" name="prepTime" placeholder="15 min" value="<%= recipe.prep_time || '' %>">
            </div>
            <div class="form-group">
              <label>Cook time</label>
              <input type="text" name="cookTime" placeholder="40 min" value="<%= recipe.cook_time || '' %>">
            </div>
            <div class="form-group">
              <label>Servings</label>
              <input type="text" name="servings" placeholder="4" value="<%= recipe.servings || '' %>">
            </div>
            <div class="form-group">
              <label>Difficulty</label>
              <select name="difficulty" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem;">
                <option value="Easy" <%= recipe.difficulty === 'Easy' ? 'selected' : '' %>>Easy</option>
                <option value="Medium" <%= recipe.difficulty === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="Hard" <%= recipe.difficulty === 'Hard' ? 'selected' : '' %>>Hard</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Ingredients Section -->
        <div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Ingredients</h3>
          <div class="form-group">
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">One per line, including measurements</p>
            <textarea name="ingredients" rows="12" placeholder="2 cups flour&#10;1 tsp salt&#10;3 tbsp olive oil&#10;..." style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;"><%= recipe.ingredients || '' %></textarea>
          </div>
        </div>

      </div>

      <!-- Categories Section -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Categories</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Select one or more categories that describe this recipe</p>
        <div class="categories-grid">
          <% categories.forEach(category => { %>
            <label class="category-checkbox">
              <input type="checkbox" name="categories" value="<%= category.id %>"
                <%= selectedCategories.includes(category.id) ? 'checked' : '' %>>
              <span class="category-checkbox-label">
                <span class="category-icon"><%= category.icon %></span>
                <span class="category-name"><%= category.name %></span>
              </span>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Tags Section -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Tags</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Add custom tags to organize your recipes (press Enter or comma to add)</p>
        <div class="tags-input-container" data-existing-tags='<%= JSON.stringify(userTags) %>' data-selected-tags='<%= JSON.stringify(selectedTags) %>'>
          <div class="tags-list"></div>
          <input type="text" class="tags-input" placeholder="Type a tag and press Enter...">
          <input type="hidden" name="tags" class="tags-hidden-input" value="">
          <div class="tags-suggestions"></div>
        </div>
      </div>

      <!-- Instructions Section (full width) -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Instructions <span style="color: var(--error-color);">*</span></h3>
        <div class="form-group">
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">Walk through the steps in order</p>
          <textarea name="instructions" rows="8" required placeholder="1. Preheat the oven to 375°F.&#10;2. In a large bowl, whisk together..." style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;"><%= recipe.instructions %></textarea>
        </div>
      </div>

      <!-- Tips & notes -->
      <div class="callout-info" style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Tips & notes</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Substitutions, storage tips, or anything else worth remembering</p>
        <textarea name="notes" rows="3" style="background: white; width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;" placeholder="This freezes well for up to 3 months. Swap butter for olive oil for a dairy-free version."><%= recipe.notes || '' %></textarea>
      </div>

      <!-- Submit buttons -->
      <div style="display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <a href="/recipes/<%= recipe.id %>" class="btn btn-outline">Cancel</a>
        <div style="display: flex; gap: 1rem;">
          <button type="submit" name="action" value="draft" class="btn btn-outline">Save as draft</button>
          <button type="submit" name="action" value="publish" class="btn btn-primary">
            <%= recipe.status === 'published' ? 'Update & Keep Published' : 'Publish recipe' %>
          </button>
        </div>
      </div>

    </div>
  </form>

</div>

<style>
  /* Responsive layout - stack on mobile */
  @media (max-width: 768px) {
    .container > form > div > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script src="/js/recipe-form.js"></script>
<script src="/js/tags-input.js"></script>

<div class="container" style="max-width: 1000px; margin: 0 auto; padding: 2rem 1rem;">

  <div style="margin-bottom: 2rem;">
    <span class="badge-new" style="display: inline-block; margin-bottom: 1rem;"><%= isClone ? 'Clone recipe' : 'New recipe' %></span>
    <h1 style="margin-bottom: 0.5rem;"><%= isClone ? 'Make this recipe your own' : 'Add a recipe to your collection' %></h1>
    <p style="color: var(--text-muted); max-width: 600px;">Fill in the details below. Only a title and instructions are required — everything else is optional.</p>
  </div>

  <form action="/recipes" method="POST" enctype="multipart/form-data" class="recipe-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="background: var(--card-background); padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">

      <!-- Two column layout for desktop, single column for mobile -->
      <div class="form-grid-2col" style="margin-bottom: 2rem;">

        <!-- Left column -->
        <div style="grid-column: 1 / -1;">
          <!-- Photo upload -->
          <div style="margin-bottom: 1.5rem;">
            <label for="photo" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Recipe Photo (optional)</label>
            <input type="file" id="photo" name="photo" accept="image/*" style="display: none;">
            <div id="photoPreview" class="photo-placeholder-pattern" style="width: 100%; height: 200px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden;">
              <span id="photoPlaceholder" style="background: white; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.875rem; color: var(--text-muted);">Click to upload photo of the finished dish</span>
              <img id="photoImage" style="display: none; width: 100%; height: 100%; object-fit: cover;">
            </div>
          </div>
        </div>

        <!-- Basic Info Section -->
        <div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Basic Information</h3>

          <div class="form-group">
            <label>Title <span style="color: var(--error-color);">*</span></label>
            <input type="text" name="title" placeholder="e.g. Grandma's Sunday Sauce" required value="<%= recipe?.title || '' %>">
          </div>

          <div class="form-group">
            <label>Author</label>
            <input type="text" name="author" placeholder="Your name" value="<%= recipe?.author || accountDisplayName || '' %>">
          </div>

          <!-- Meta fields grid -->
          <div class="form-grid-meta">
            <div class="form-group">
              <label>Prep Time <span style="color: var(--error-color);">*</span></label>
              <input type="text" id="prepTime" name="prepTime" placeholder="15 min" aria-required="true" aria-describedby="prepTimeError" value="<%= recipe?.prep_time || '' %>">
              <span class="field-error-message" id="prepTimeError">Required</span>
            </div>
            <div class="form-group">
              <!-- REW-52: displayed as "Total Time" per the ticket, but the underlying
                   name/DB column intentionally stay cookTime/cook_time (no migration). -->
              <label>Total Time <span style="color: var(--error-color);">*</span></label>
              <input type="text" id="cookTime" name="cookTime" placeholder="40 min" aria-required="true" aria-describedby="cookTimeError" value="<%= recipe?.cook_time || '' %>">
              <span class="field-error-message" id="cookTimeError">Required</span>
            </div>
            <div class="form-group">
              <label>Servings</label>
              <input type="text" name="servings" placeholder="4" value="<%= recipe?.servings || '' %>">
            </div>
            <div class="form-group">
              <label>Difficulty</label>
              <select name="difficulty" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem;">
                <option value="Easy" <%= !recipe?.difficulty || recipe.difficulty === 'Easy' ? 'selected' : '' %>>Easy</option>
                <option value="Medium" <%= recipe?.difficulty === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="Hard" <%= recipe?.difficulty === 'Hard' ? 'selected' : '' %>>Hard</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Ingredients Section -->
        <div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Ingredients</h3>
          <div class="form-group">
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">One per line, including measurements</p>
            <textarea name="ingredients" rows="12" placeholder="2 cups flour&#10;1 tsp salt&#10;3 tbsp olive oil&#10;..." style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;"><%= recipe?.ingredients || '' %></textarea>
          </div>
        </div>

      </div>

      <!-- Categories Section -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Categories</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Select one or more categories that describe this recipe</p>
        <div class="categories-grid">
          <% categories.forEach(category => { %>
            <label class="category-checkbox">
              <input type="checkbox" name="categories" value="<%= category.id %>"
                <%= selectedCategories.includes(category.id) ? 'checked' : '' %>>
              <span class="category-checkbox-label">
                <span class="category-icon"><%= category.icon %></span>
                <span class="category-name"><%= category.name %></span>
              </span>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Tags Section -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Tags</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Add custom tags to organize your recipes (press Enter or comma to add)</p>
        <div class="tags-input-container" data-existing-tags='<%= JSON.stringify(userTags) %>' data-selected-tags='<%= JSON.stringify(selectedTags) %>'>
          <div class="tags-list"></div>
          <input type="text" class="tags-input" placeholder="Type a tag and press Enter...">
          <input type="hidden" name="tags" class="tags-hidden-input" value="">
          <div class="tags-suggestions"></div>
        </div>
      </div>

      <!-- Instructions Section (full width) -->
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary-color);">Instructions <span style="color: var(--error-color);">*</span></h3>
        <div class="form-group">
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">Walk through the steps in order</p>
          <textarea name="instructions" rows="8" required placeholder="1. Preheat the oven to 375°F.&#10;2. In a large bowl, whisk together..." style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;"><%= recipe?.instructions || '' %></textarea>
        </div>
      </div>

      <!-- Tips & notes -->
      <div class="callout-info" style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Tips & notes</h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem;">Substitutions, storage tips, or anything else worth remembering</p>
        <textarea name="notes" rows="3" style="background: white; width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem; font-family: inherit; resize: vertical;" placeholder="This freezes well for up to 3 months. Swap butter for olive oil for a dairy-free version."><%= recipe?.notes || '' %></textarea>
      </div>

      <!-- Optional meal plan assignment -->
      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label for="mealPlanId" style="font-weight: 600;">Add to a meal plan (optional)</label>
        <% if (mealPlans.length) { %>
          <select id="mealPlanId" name="mealPlanId" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 1rem;">
            <option value="">Don't add to a meal plan</option>
            <% mealPlans.forEach(mealPlan => { %>
              <option value="<%= mealPlan.id %>"><%= mealPlan.title %> (<%= mealPlan.start_date %> – <%= mealPlan.end_date %>)</option>
            <% }); %>
          </select>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">The recipe will be saved first, then added to the selected plan.</p>
        <% } else { %>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">You don't have any meal plans yet. <a href="/meal-plans/new">Create a meal plan</a> if you'd like to organize this recipe later.</p>
        <% } %>
      </div>

      <fieldset class="visibility-control">
        <legend>Visibility</legend>
        <div class="visibility-options">
          <label class="visibility-option"><input type="radio" name="visibility" value="private" <%= visibility !== 'public' ? 'checked' : '' %>><span><strong>Private</strong><small>Only you can view this recipe.</small></span></label>
          <label class="visibility-option"><input type="radio" name="visibility" value="public" <%= visibility === 'public' ? 'checked' : '' %>><span><strong>Public</strong><small>Anyone can find and view this recipe.</small></span></label>
        </div>
      </fieldset>
      <div class="recipe-form-actions">
        <button type="submit" class="btn btn-primary">Save recipe</button>
      </div>

    </div>
  </form>

</div>

<script src="/js/recipe-form.js"></script>
<script src="/js/tags-input.js"></script>

<div class="container" style="max-width: 1200px; padding: 2rem 1rem;">

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <h1>My Recipes</h1>
      <p style="color: var(--text-muted);">Manage your recipe collection</p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="/recipes/import" class="btn btn-outline" style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.125rem;">&#128196;</span> Import Recipe
      </a>
      <a href="/recipes/new" class="btn btn-primary">Add New Recipe</a>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar" style="background: var(--card-background); padding: 1rem 1.5rem; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 2rem;">
    <form method="GET" action="/recipes" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">

      <!-- Category Filter -->
      <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
        <label style="font-size: 0.875rem; margin-bottom: 0.5rem; display: block;">Category</label>
        <select name="category" onchange="this.form.submit()" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-size: 0.9375rem;">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.slug %>" <%= selectedCategory === cat.slug ? 'selected' : '' %>>
              <%= cat.icon %> <%= cat.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Tags Filter -->
      <div class="form-group" style="flex: 2; min-width: 250px; margin-bottom: 0;">
        <label style="font-size: 0.875rem; margin-bottom: 0.5rem; display: block;">Tags</label>
        <div class="filter-tags-container" data-existing-tags='<%= JSON.stringify(userTags) %>'>
          <div class="filter-tags-list"></div>
          <input type="text" class="filter-tags-input" placeholder="Filter by tags...">
          <input type="hidden" name="tags" class="filter-tags-hidden" value="<%= selectedTags %>">
          <div class="filter-tags-suggestions"></div>
        </div>
      </div>

      <!-- Clear Filters -->
      <% if (selectedCategory || selectedTags) { %>
        <a href="/recipes" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.875rem;">Clear Filters</a>
      <% } %>

    </form>
  </div>

  <% if (recipes.length === 0) { %>
    <div style="text-align: center; padding: 4rem 2rem; background: var(--card-background); border-radius: var(--radius); box-shadow: var(--shadow);">
      <% if (selectedCategory || selectedTags) { %>
        <h3 style="color: var(--text-muted); margin-bottom: 1rem;">No recipes match your filters</h3>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Try adjusting your filters or clear them to see all recipes.</p>
        <a href="/recipes" class="btn btn-outline">Clear Filters</a>
      <% } else { %>
        <h3 style="color: var(--text-muted); margin-bottom: 1rem;">No recipes yet</h3>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Start building your recipe collection by adding your first recipe!</p>
        <a href="/recipes/new" class="btn btn-primary">Create Your First Recipe</a>
      <% } %>
    </div>
  <% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
      <% recipes.forEach(recipe => { %>
        <div class="feature-card" style="position: relative; display: flex; flex-direction: column;">
          <!-- Recipe thumbnail -->
          <% if (recipe.thumbnail_url) { %>
            <a href="/recipes/<%= recipe.id %>" style="display: block; margin-bottom: 1rem;">
              <div style="width: 100%; height: 200px; background: #f5f5f5; border-radius: var(--radius); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <img src="<%= recipe.thumbnail_url %>" alt="<%= recipe.title %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            </a>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
            <h3 style="margin: 0; flex: 1;">
              <a href="/recipes/<%= recipe.id %>" style="color: inherit; text-decoration: none;">
                <%= recipe.title %>
              </a>
            </h3>
            <% if (recipe.status === 'draft') { %>
              <span style="background-color: #f8d7da; color: #721c24; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">Draft</span>
            <% } else { %>
              <span style="background-color: #d4edda; color: #155724; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">Published</span>
            <% } %>
          </div>

          <% if (recipe.author) { %>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem;">By <%= recipe.author %></p>
          <% } %>

          <!-- Category badges -->
          <% if (recipe.categories && recipe.categories.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
              <% recipe.categories.forEach(cat => { %>
                <a href="/recipes?category=<%= cat.slug %>" class="category-badge" title="<%= cat.name %>">
                  <span><%= cat.icon %></span> <%= cat.name %>
                </a>
              <% }); %>
            </div>
          <% } %>

          <!-- Tags -->
          <% if (recipe.tags && recipe.tags.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem;">
              <% recipe.tags.forEach(tag => { %>
                <a href="/recipes?tags=<%= tag.slug %>" class="tag-badge"><%= tag.name %></a>
              <% }); %>
            </div>
          <% } %>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">
            <% if (recipe.prep_time) { %>
              <span>Prep: <%= recipe.prep_time %></span>
            <% } %>
            <% if (recipe.cook_time) { %>
              <span>Cook: <%= recipe.cook_time %></span>
            <% } %>
            <% if (recipe.servings) { %>
              <span><%= recipe.servings %> servings</span>
            <% } %>
            <% if (recipe.difficulty) { %>
              <span><%= recipe.difficulty %></span>
            <% } %>
          </div>

          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.75rem; margin-bottom: 0.75rem;">
            Created <%= new Date(recipe.created_at).toLocaleDateString() %>
          </p>

          <!-- Action buttons -->
          <div style="display: flex; gap: 0.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <a href="/recipes/<%= recipe.id %>" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">View</a>
            <a href="/recipes/<%= recipe.id %>/edit" class="btn btn-outline" style="flex: 1; text-align: center; font-size: 0.875rem; padding: 0.5rem 1rem;">Edit</a>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin: 0; flex: 1;" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn" style="width: 100%; background-color: var(--error-color); color: white; border-color: var(--error-color); font-size: 0.875rem; padding: 0.5rem 1rem;">Delete</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<script src="/js/tags-input.js"></script>

<div class="page-narrow">
  <div class="page-header">
    <h1>My Favorites</h1>
    <p class="page-subtitle">Recipes you've favorited for later</p>
  </div>

  <% if (recipes.length === 0) { %>
    <div class="empty-state">
      <h3>No favorites yet</h3>
      <p>Browse recipes and click the heart button to add them to your favorites.</p>
      <a href="/browse" class="btn btn-primary">Browse Recipes</a>
    </div>
  <% } else { %>
    <p class="result-count"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %></p>

    <div class="organization-card-grid">
      <% recipes.forEach(function(recipe) { %>
        <%#
          REW-87: the shared standardized card, third surface. Ownership is
          mixed on this page, so the partial decides Edit/Delete per card from
          recipe.user_id -- which is never rendered into the markup.
        %>
        <%- include('../partials/recipe-summary-card', { recipe, surface: 'favorites' }) %>
      <% }); %>
    </div>
  <% } %>
</div>
